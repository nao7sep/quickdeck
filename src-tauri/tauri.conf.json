{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickDeck",
  "version": "0.1.0",
  "identifier": "com.quickdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickDeck",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 420,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
